## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
*.pidb

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache directory
.vs/
# Uncomment if you have tasks that create to-do list files in the project directory
#*.tasks

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Office Extension Files
-built.*

# ReSharper is a code analysis tool for Visual Studio
_ReSharper*/
*.[Re]Sharper.user
*.DotSettings.user

# JustCode Enterprise Edition
.JustCode

# TeamCity is a build tool
_TeamCity*

# DotCover is a Code Coverage Tool
Ankh.UserData

# MyGet is a package registry
MyGet.settings.xml

# Navision 3-tier client
*.runsettings

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Emulator
ecf/
rcf/

# Azure Microservices Framework
PublishProfiles/

# Performance Tools Temp Files
*.pgc
*.pgd
*.psess
*.vsp
*.vspx
*.sap

# Format Map file
*.flt

# Node Webkit Target
node_modules/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Windows image analyses cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Mac OS metadata
.DS_Store
