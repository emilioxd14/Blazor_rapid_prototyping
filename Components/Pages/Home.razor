@page "/"
@using FH_Kufstein_Blazor_WebAppProject.Models
@using FH_Kufstein_Blazor_WebAppProject.DataClients
@inject ContainerDataClient DataClient
@rendermode InteractiveServer

<PageTitle>Nuclear Storage Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-white fw-bold">Nuclear Storage Manager</h1>
    <a href="/editcontainerdata" class="btn btn-success shadow-sm" role="button">
        <i class="bi bi-plus-circle-fill me-2"></i>Add New Container
    </a>
</div>

<div class="card shadow" style="background-color: #161d30; color: white; border: 1px solid rgba(255,255,255,0.05);">
    <div class="card-header border-bottom" style="background-color: rgba(0,0,0,0.2); border-color: rgba(255,255,255,0.05) !important;">
        <h3 class="card-title mb-0 text-white">Monitored Nuclear Storage Units</h3>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover mb-0" style="border-color: rgba(255,255,255,0.05);">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Date / Time</th>
                            <th>Location</th>
                            <th>Container Type</th>
                            <th>Capacity (L)</th>
                            <th>Current Level (L)</th>
                            <th>Measurement Data</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var container in containers)
                        {
                            <tr>
                                <td class="align-middle"><span class="badge bg-secondary">@container.Id</span></td>
                                <td class="fw-bold align-middle">@container.Name</td>
                                <td class="align-middle">@container.DateTime.ToString("g")</td>
                                <td class="align-middle"><i class="bi bi-geo-alt-fill text-danger"></i> @container.Location</td>
                                <td class="align-middle"><span class="badge bg-info text-dark">@container.ContainerType</span></td>
                                <td class="align-middle">@container.Capacity.ToString("N0")</td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <span class="me-2">@container.CurrentLevel.ToString("N0")</span>
                                        @{
                                            var percentage = (container.CurrentLevel * 100) / container.Capacity;
                                            var progressColor = percentage > 80 ? "bg-danger" : percentage > 50 ? "bg-warning" : "bg-success";
                                        }
                                        <div class="progress w-100" style="height: 6px;">
                                            <div class="progress-bar @progressColor" role="progressbar" style="width: @percentage%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (container.Measurements != null)
                                    {
                                        <ul class="list-group list-group-flush small">
                                            @foreach (var measurement in container.Measurements)
                                            {
                                                <li class="list-group-item p-1 bg-transparent text-white">
                                                    <i class="bi bi-activity text-warning"></i> @measurement
                                                </li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/editcontainerdata/@container.Id" class="btn btn-sm d-inline-flex align-items-center px-3 py-1.5" style="background-color: rgba(59, 130, 246, 0.1); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 6px; font-weight: 500; font-size: 0.8rem; text-decoration: none; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='rgba(59, 130, 246, 0.25)'; this.style.color='#93c5fd'; this.style.borderColor='rgba(59, 130, 246, 0.4)';" onmouseout="this.style.backgroundColor='rgba(59, 130, 246, 0.1)'; this.style.color='#60a5fa'; this.style.borderColor='rgba(59, 130, 246, 0.25)';">
                                            <i class="bi bi-pencil-square me-1.5"></i> Edit
                                        </a>
                                        <a href="/delete/@container.Id" class="btn btn-sm d-inline-flex align-items-center px-3 py-1.5" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 6px; font-weight: 500; font-size: 0.8rem; text-decoration: none; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='rgba(239, 68, 68, 0.25)'; this.style.color='#fca5a5'; this.style.borderColor='rgba(239, 68, 68, 0.4)';" onmouseout="this.style.backgroundColor='rgba(239, 68, 68, 0.1)'; this.style.color='#f87171'; this.style.borderColor='rgba(239, 68, 68, 0.25)';">
                                            <i class="bi bi-trash3-fill me-1.5"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

@code {
    private List<ContainerData> containers = [];

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        containers = DataClient.GetContainers();
    }

    private void RemoveContainer(int id)
    {
        // Remueve el objeto de la lista en el cliente Singleton
        DataClient.DeleteContainerData(id);
        
        // Actualiza la referencia local para que Blazor re-renderice la tabla inmediatamente
        RefreshData();
    }
}