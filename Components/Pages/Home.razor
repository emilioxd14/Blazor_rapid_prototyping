@page "/"
@using FH_Kufstein_Blazor_WebAppProject.Models
@using FH_Kufstein_Blazor_WebAppProject.DataClients
@inject ContainerDataClient DataClient
@rendermode InteractiveServer

<PageTitle>Nuclear Storage Manager</PageTitle>

<div class="card shadow" style="background-color: #161d30; color: white; border: 1px solid rgba(255,255,255,0.05);">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center" style="background-color: rgba(0,0,0,0.2); border-color: rgba(255,255,255,0.05) !important;">
        <h3 class="card-title mb-0 text-white">Monitored Nuclear Storage Units</h3>
        <a href="/editcontainerdata" class="btn btn-success shadow-sm" role="button">
            <i class="bi bi-plus-circle-fill me-2"></i>Add New Container
        </a>
    </div>
    <div class="card-body p-3">
        <RadzenDataGrid AllowFiltering="true" 
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                        AllowPaging="true" 
                        PageSize="5" 
                        AllowSorting="true" 
                        Data="@containers" 
                        TItem="ContainerData" 
                        SelectionMode="DataGridSelectionMode.Single"
                        Responsive="true"
                        EmptyText="No nuclear units to show."
                        class="custom-nuclear-grid">
            <Columns>
                <RadzenDataGridColumn TItem="ContainerData" Property="Id" Title="Id" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="container">
                        <span class="badge bg-secondary text-white">@container.Id</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="Name" Title="Name" Width="140px">
                    <Template Context="container">
                        <span class="fw-bold">@container.Name</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="DateTime" Title="Date / Time" Width="150px">
                    <Template Context="container">
                        <span>@container.DateTime.ToString("g")</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="Location" Title="Location" Width="120px">
                    <Template Context="container">
                        <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>@container.Location</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="ContainerType" Title="Type" Width="125px">
                    <Template Context="container">
                        <span class="badge bg-info text-dark">@container.ContainerType</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="Capacity" Title="Capacity (L)" Width="120px">
                    <Template Context="container">
                        <span>@container.Capacity.ToString("N0")</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="CurrentLevel" Title="Current Level (L)" Width="200px">
                    <Template Context="container">
                        <div class="d-flex align-items-center w-100">
                            <span class="me-2">@container.CurrentLevel.ToString("N0")</span>
                            @{
                                var percentage = (container.CurrentLevel * 100) / container.Capacity;
                                var progressColor = percentage > 80 ? "bg-danger" : percentage > 50 ? "bg-warning" : "bg-success";
                            }
                            <div class="progress flex-grow-1" style="height: 6px;">
                                <div class="progress-bar @progressColor" role="progressbar" style="width: @percentage%"></div>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Property="Measurements" Title="Measurement Data" Sortable="false" Filterable="false" Width="260px">
                    <Template Context="container">
                        @if (container.Measurements != null)
                        {
                            <ul class="list-group list-group-flush small bg-transparent p-0 m-0 border-0">
                                @foreach (var measurement in container.Measurements)
                                {
                                    <li class="list-group-item p-1 bg-transparent border-0">
                                        <i class="bi bi-activity text-warning me-1"></i>@measurement
                                    </li>
                                }
                            </ul>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ContainerData" Title="Actions" Sortable="false" Filterable="false" Width="170px" TextAlign="TextAlign.Center">
                    <Template Context="container">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="/editcontainerdata/@container.Id" class="btn btn-sm d-inline-flex align-items-center px-2 py-1" style="background-color: rgba(59, 130, 246, 0.1); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 6px; font-weight: 500; font-size: 0.75rem; text-decoration: none; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='rgba(59, 130, 246, 0.25)'; this.style.color='#93c5fd';" onmouseout="this.style.backgroundColor='rgba(59, 130, 246, 0.1)'; this.style.color='#60a5fa';">
                                <i class="bi bi-pencil-square me-1"></i>Edit
                            </a>
                            <a href="/delete/@container.Id" class="btn btn-sm d-inline-flex align-items-center px-2 py-1" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 6px; font-weight: 500; font-size: 0.75rem; text-decoration: none; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='rgba(239, 68, 68, 0.25)'; this.style.color='#fca5a5';" onmouseout="this.style.backgroundColor='rgba(239, 68, 68, 0.1)'; this.style.color='#f87171';">
                                <i class="bi bi-trash3-fill me-1"></i>Delete
                            </a>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
    </div>

@code {
    private List<ContainerData> containers = [];

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        containers = DataClient.GetContainers();
    }

    private void RemoveContainer(int id)
    {
        // Remueve el objeto de la lista en el cliente Singleton
        DataClient.DeleteContainerData(id);
        
        // Actualiza la referencia local para que Blazor re-renderice la tabla inmediatamente
        RefreshData();
    }
}